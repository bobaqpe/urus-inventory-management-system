erDiagram
    businesses ||--o{ business_memberships : has
    users ||--o{ business_memberships : joins
    businesses ||--o{ categories : owns
    businesses ||--o{ suppliers : owns
    businesses ||--o{ products : owns
    businesses ||--o{ purchase_orders : owns
    categories ||--o{ products : categorizes
    suppliers ||--o{ products : primary_supplier
    products ||--o{ product_suppliers : has
    suppliers ||--o{ product_suppliers : supplies
    business_memberships ||--o{ purchase_orders : creates
    suppliers ||--o{ purchase_orders : receives_order
    purchase_orders ||--o{ purchase_order_items : contains
    products ||--o{ purchase_order_items : ordered
    products ||--o{ stock_movements : changes
    business_memberships ||--o{ stock_movements : records
    purchase_orders o|--o{ stock_movements : generates

    businesses {
        bigint id PK
        text name
        char3 currency
        text timezone
    }
    users {
        bigint id PK
        text firebase_uid UK
        text email "nullable"
    }
    business_memberships {
        bigint business_id PK,FK
        bigint user_id PK,FK
        text role
    }
    categories {
        bigint id PK
        bigint business_id FK
        text name
    }
    suppliers {
        bigint id PK
        bigint business_id FK
        text name
        text contact_name "nullable"
        text phone "nullable"
        text email "nullable"
        text address "nullable"
        text notes "nullable"
        timestamptz archived_at "nullable"
    }
    products {
        bigint id PK
        bigint business_id FK
        bigint category_id FK
        bigint supplier_id FK "primary supplier"
        text name
        text sku
        text unit
        decimal stock
        decimal reorder_level
        decimal cost_price
        date expiry_date "nullable"
        timestamptz archived_at "nullable"
        timestamptz created_at
        timestamptz updated_at
    }
    product_suppliers {
        bigint business_id PK,FK
        bigint product_id PK,FK
        bigint supplier_id PK,FK
    }
    purchase_orders {
        bigint id PK
        bigint business_id FK
        bigint supplier_id FK
        bigint created_by FK
        text status
        timestamptz created_at
        timestamptz received_at "nullable"
    }
    purchase_order_items {
        bigint id PK
        bigint business_id FK
        bigint order_id FK
        bigint product_id FK
        decimal quantity
        decimal unit_cost
    }
    stock_movements {
        bigint id PK
        bigint business_id FK
        bigint product_id FK
        bigint actor_id FK
        bigint purchase_order_id FK "nullable"
        decimal quantity_delta
        text reason
        timestamptz created_at
    }
